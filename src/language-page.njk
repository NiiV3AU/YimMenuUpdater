<body>
  <div id="alert-banner" class="alert-banner info-mode" role="alert">
    <div class="container alert-container">
      <div class="alert-content">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" class="alert-icon"
          fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
          <circle cx="12" cy="12" r="10" />
          <path d="M12 16v-4" />
          <path d="M12 8h.01" />
        </svg>
        {% set placeholder = alert_placeholders[lang.code] or alert_placeholders['en'] %}
        <span class="alert-text">{{ placeholder | replace('{version}', release.tag) | safe }}</span>
      </div>
      <button id="alert-close-btn" class="alert-close" aria-label="{{ locales[lang.code].ui_aria.close_alert or 'Close alert' }}">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>
    <script>
      (function () {
        const alertBanner = document.getElementById('alert-banner');
        const closeBtn = document.getElementById('alert-close-btn');
        const bannerId = '{{ release.bannerId }}';
        try {
          if (localStorage.getItem(bannerId)) {
            alertBanner.classList.add('is-dismissed');
            alertBanner.style.display = 'none';
          }
        } catch (e) {}
        if (closeBtn) {
          closeBtn.addEventListener('click', function () {
            alertBanner.classList.add('is-dismissed');
            alertBanner.style.display = 'none';
            try { localStorage.setItem(bannerId, 'dismissed'); } catch (e) {}
          });
        }
      })();
    </script>
  </div>
