  <script>
    (function () {
      var shaEl = document.getElementById("ymu-sha256");
      if (!shaEl) return;
      var wrap = shaEl.closest(".sha256-wrap");
      var ttText = wrap ? wrap.querySelector(".sha-tooltip-text") : null;
      var fullSha = shaEl.getAttribute("data-sha");

      function copy() {
        var t = shaEl.getAttribute("data-sha");
        if (!t || !navigator.clipboard) return;
        var copiedLabel = shaEl.getAttribute("data-copied-text") || "Copied!";
        var copyLabel = shaEl.getAttribute("data-copy-text") || "Copy";
        navigator.clipboard.writeText(t).then(function () {
          shaEl.classList.add("copied");
          if (ttText) ttText.textContent = copiedLabel;
          setTimeout(function () {
            shaEl.classList.remove("copied");
            if (ttText) ttText.textContent = copyLabel;
          }, 1200);
        });
      }
      shaEl.addEventListener("click", copy);
      shaEl.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          copy();
        }
      });
      var tip = wrap ? wrap.querySelector(".sha-tooltip") : null;
      shaEl.addEventListener("mousemove", function (e) {
        if (!tip) return;
        var r = wrap.getBoundingClientRect();
        var half = tip.offsetWidth / 2;
        var x = e.clientX - r.left;
        tip.style.left = Math.max(half, Math.min(x, r.width - half)) + "px";
      });
      function renderSha() {
        if (!fullSha) return;
        shaEl.textContent = fullSha;
        if (shaEl.scrollWidth > shaEl.clientWidth) {
          var keep = 8;
          shaEl.textContent = fullSha.slice(0, keep) + "…" + fullSha.slice(-keep);
        }
      }
      renderSha();
      var resizeTimer;
      window.addEventListener("resize", function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(renderSha, 150);
      });
    })();
  </script>
