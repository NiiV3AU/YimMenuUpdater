---
pagination:
  data: languages.items
  size: 1
  alias: lang
permalink: "/{{ lang.code }}/"
---
<!DOCTYPE html>
<html lang="{{ lang.code }}" {% if lang.dir %} dir="{{ lang.dir }}" {% endif %}>

<head>
  <link rel="canonical" href="{{ metadata.url }}{{ page.url }}" />
  {%- for item in languages.items -%}
  <link rel="alternate" hreflang="{{ item.code }}" href="{{ metadata.url }}/{{ item.code }}/" />
  {%- endfor -%}
  <link rel="alternate" hreflang="x-default" href="{{ metadata.url }}/" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ locales[lang.code].page_title }}</title>
  <meta name="google-site-verification" content="_f6dGnLNZBlwsL9BdFwl6TM5fzcSC5_ubno6fyX9SIg" />
  <link rel="icon" href="{{ '/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ '/favicon-32x32.png' | url }}">
  <link rel="icon" type="image/png" sizes="16x16" href="{{ '/favicon-16x16.png' | url }}">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ '/apple-touch-icon.png' | url }}">
  <link rel="manifest" href="{{ '/site.webmanifest' | url }}">
  <link rel="preload" href="/assets/fonts/rubik-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous">
  {%- if lang.code == 'ar' %}
  <link rel="preload" href="/assets/fonts/rubik-arabic-wght-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous">
  {%- elif lang.code == 'ru' or lang.code == 'uk' %}
